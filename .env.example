# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials

# ============================================================
# REQUIRED SETTINGS
# ============================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Telegram Bot Username (without @)
BOT_USERNAME=

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/buy_sell_bot

# Superadmin Telegram User ID (numeric)
# Get this from @userinfobot or similar
SUPERADMIN_TELEGRAM_ID=

# Public Channel ID (numeric, starts with -100)
# Or channel username (with @)
PUBLIC_CHANNEL_ID=

# Public Channel Username (with @, e.g. @my_marketplace)
PUBLIC_CHANNEL_USERNAME=

# ============================================================
# OPTIONAL SETTINGS — Defaults are shown
# ============================================================

# AI Provider Configuration (leave empty to disable AI features)
# Supported: openai, gemini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Default language: en (English) or am (Amharic)
DEFAULT_LANGUAGE=en

# Privacy notice version (increment when notice changes)
PRIVACY_NOTICE_VERSION=1

# Marketplace limits
MAX_ACTIVE_LISTINGS_PER_USER=10
MAX_PHOTOS_PER_LISTING=5
MAX_DESCRIPTION_LENGTH=2000
MAX_TITLE_LENGTH=100

# Rate limits
MESSAGE_RATE_LIMIT=30
LISTING_RATE_LIMIT=5

# Data retention (days, 0 = keep forever)
DATA_RETENTION_DAYS=365

# Spam detection
SPAM_DUPLICATE_WINDOW_SECONDS=60
SPAM_MAX_DUPLICATE_MESSAGES=3
